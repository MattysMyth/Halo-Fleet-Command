{
  "name": "halo-fleet-command",
  "private": true,
  "version": "0.1.0",
  "description": "Incremental fleet-management game set in the Halo universe (fan project, non-commercial)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "tsx tools/balance-sim.ts",
    "artifact": "npm run build && node tools/make-artifact.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "break_infinity.js": "^2.2.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
